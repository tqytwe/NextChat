# Copy this file to a private Android release env file before building.
# NEXT_PUBLIC_SUB2API_BASE_URL is required and is fixed into the APK.
NEXT_PUBLIC_SUB2API_BASE_URL=
NEXT_PUBLIC_NEXTCHAT_WEB_URL=
NEXT_PUBLIC_ANDROID_APK_URL=/downloads/jisudengchat-android.apk
NEXT_PUBLIC_ANDROID_MANIFEST_URL=/downloads/android-version.json
NEXT_PUBLIC_ANDROID_VERSION=2.0.1
ANDROID_VERSION_NAME=2.0.1
ANDROID_VERSION_CODE=20001
NEXT_PUBLIC_ANDROID_APK_SIZE=
NEXT_PUBLIC_ANDROID_APK_SHA256=
NEXT_PUBLIC_ANDROID_RELEASE_NOTES=修复 Android 登录网络请求失败；平台账号登录、余额、分组和模型同步改用原生 HTTP；聊天和生图支持安卓本机保存

# Optional: build the Android shell against a hosted JisudengChat web bundle.
# When this is set, Capacitor loads the URL instead of requiring static export assets.
CAPACITOR_SERVER_URL=
