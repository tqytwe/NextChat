{
  "name": "nextchat",
  "private": false,
  "license": "mit",
  "scripts": {
    "mask": "npx tsx app/masks/build.ts",
    "mask:watch": "npx watch \"yarn mask\" app/masks",
    "dev": "concurrently -r \"yarn run mask:watch\" \"next dev\"",
    "build": "yarn mask && cross-env BUILD_MODE=standalone next build",
    "start": "next start",
    "lint": "next lint",
    "export": "yarn mask && cross-env BUILD_MODE=export BUILD_APP=1 next build",
    "export:dev": "concurrently -r \"yarn mask:watch\"  \"cross-env BUILD_MODE=export BUILD_APP=1 next dev\"",
    "android:doctor": "bash scripts/android-with-toolchain.sh node tools/android/doctor.mjs --channel=direct",
    "android:toolchain:provision": "bash scripts/android-with-toolchain.sh node tools/android/provision.mjs",
    "android:docs:check": "node tools/android/check-mobile-docs.mjs",
    "android:export": "yarn android:export:direct",
    "android:export:direct": "bash scripts/android-with-toolchain.sh yarn android:export:direct:internal",
    "android:export:direct:internal": "node scripts/validate-android-env.mjs && yarn mask && cross-env BUILD_MODE=export BUILD_APP=1 BUILD_ANDROID=1 NEXT_PUBLIC_ANDROID_DISTRIBUTION=direct NEXT_PUBLIC_ANDROID_DIRECT_REDEEM_SHOP_URL=https://pay.ldxp.cn/shop/4B4R3T44 next build && node scripts/prepare-android-web-assets.mjs && node scripts/snapshot-android-web-assets.mjs direct",
    "android:export:play": "bash scripts/android-with-toolchain.sh yarn android:export:play:internal",
    "android:export:play:internal": "node scripts/validate-android-env.mjs && yarn mask && cross-env BUILD_MODE=export BUILD_APP=1 BUILD_ANDROID=1 NEXT_PUBLIC_ANDROID_DISTRIBUTION=play next build && node scripts/prepare-android-web-assets.mjs && node scripts/snapshot-android-web-assets.mjs play && node scripts/check-android-play-assets.mjs",
    "android:web": "node scripts/validate-android-env.mjs && yarn mask && cross-env BUILD_MODE=standalone BUILD_APP=1 BUILD_ANDROID=1 next build",
    "android:add": "npx cap add android",
    "android:sync": "bash scripts/android-with-toolchain.sh yarn android:sync:internal",
    "android:sync:internal": "yarn android:export:direct:internal && npx cap sync android",
    "android:sync:remote": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "bash scripts/android-with-direct-release-env.sh yarn android:build:internal",
    "android:build:internal": "node tools/android/doctor.mjs --channel=direct --require-release-secrets && node scripts/validate-android-fcm-config.mjs --distribution=direct && yarn android:export:direct:internal && npx cap sync android && cd android && ./gradlew --offline assembleDirectRelease",
    "android:bundle:play": "bash scripts/android-with-toolchain.sh yarn android:bundle:play:internal",
    "android:bundle:play:internal": "node tools/android/doctor.mjs --channel=play --require-release-secrets && node scripts/validate-android-fcm-config.mjs --distribution=play && yarn android:export:play:internal && npx cap sync android && cd android && ./gradlew --offline bundlePlayRelease",
    "android:package": "bash scripts/android-with-direct-release-env.sh yarn android:package:internal",
    "android:package:internal": "node tools/android/doctor.mjs --channel=direct --require-release-secrets && node scripts/package-android-release.mjs",
    "android:package:play": "bash scripts/android-with-toolchain.sh yarn android:package:play:internal",
    "android:package:play:internal": "node tools/android/doctor.mjs --channel=play --require-release-secrets && node scripts/package-android-play-release.mjs",
    "android:release": "bash scripts/android-with-direct-release-env.sh yarn android:release:internal",
    "android:release:internal": "yarn android:build:internal && yarn android:package:internal",
    "android:release:play": "bash scripts/android-with-toolchain.sh yarn android:release:play:internal",
    "android:release:play:internal": "yarn android:bundle:play:internal && yarn android:package:play:internal",
    "android:emulator:start": "bash scripts/android-with-toolchain.sh bash scripts/android-emulator-start.sh",
    "android:emulator:smoke": "bash scripts/android-with-toolchain.sh bash scripts/android-emulator-smoke.sh",
    "android:emulator:e2e": "bash scripts/android-with-toolchain.sh bash scripts/android-maestro-e2e.sh",
    "app:dev": "concurrently -r \"yarn mask:watch\" \"yarn tauri dev\"",
    "app:build": "yarn mask && yarn tauri build",
    "app:clear": "yarn tauri dev",
    "prompts": "node ./scripts/fetch-prompts.mjs",
    "prepare": "husky install",
    "proxy-dev": "sh ./scripts/init-proxy.sh && proxychains -f ./scripts/proxychains.conf yarn dev",
    "test": "node --no-warnings --experimental-vm-modules $(yarn bin jest) --watch",
    "test:ci": "node --no-warnings --experimental-vm-modules $(yarn bin jest) --ci"
  },
  "dependencies": {
    "@capacitor/android": "7.6.8",
    "@capacitor/core": "7.6.8",
    "@capacitor/push-notifications": "7.0.3",
    "@fortaine/fetch-event-source": "^3.0.6",
    "@hello-pangea/dnd": "^16.5.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@next/third-parties": "^14.1.0",
    "@svgr/webpack": "^6.5.1",
    "@types/qrcode": "1.5.5",
    "@vercel/analytics": "^0.1.11",
    "@vercel/speed-insights": "^1.0.2",
    "axios": "^1.7.5",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.9.2",
    "fflate": "0.8.2",
    "fuse.js": "^7.0.0",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.11",
    "idb-keyval": "^6.2.1",
    "lodash-es": "^4.17.21",
    "markdown-to-txt": "^2.0.1",
    "mermaid": "^10.6.1",
    "nanoid": "^5.0.3",
    "next": "^14.1.1",
    "node-fetch": "^3.3.1",
    "openapi-client-axios": "^7.5.5",
    "qrcode": "1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^8.0.7",
    "react-router-dom": "^6.15.0",
    "rehype-highlight": "^6.0.0",
    "rehype-katex": "^6.0.3",
    "remark-breaks": "^3.0.2",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "rt-client": "https://github.com/Azure-Samples/aoai-realtime-audio-sdk/releases/download/js/v0.5.0/rt-client-0.5.0.tgz",
    "sass": "^1.59.2",
    "spark-md5": "^3.0.2",
    "use-debounce": "^9.0.4",
    "zod": "^3.24.1",
    "zustand": "^4.3.8"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.8",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/cli": "1.5.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.70",
    "@types/react-dom": "^18.2.7",
    "@types/react-katex": "^3.0.0",
    "@types/spark-md5": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "6.4.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.49.0",
    "eslint-config-next": "13.4.19",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unused-imports": "^3.2.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^13.2.2",
    "prettier": "^3.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.0",
    "typescript": "5.2.2",
    "watch": "^1.0.2",
    "webpack": "^5.88.1"
  },
  "resolutions": {
    "lint-staged/yaml": "^2.2.2"
  },
  "packageManager": "yarn@1.22.19"
}
